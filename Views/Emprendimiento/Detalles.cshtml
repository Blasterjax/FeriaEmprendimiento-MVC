@model FeriaEmprendimiento.Models.Emprendimiento
@{
    ViewData["Title"] = "Detalles - " + Model.Nombre;
}

<div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
    <div>
        <h2 class="h4 fw-bold mb-0">Detalles del Emprendimiento</h2>
        <span class="text-muted small">Información registrada del stand</span>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        Volver al Catálogo
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm border">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <span class="fw-bold">@Model.Nombre</span>
                <span class="badge bg-primary">Stand @Model.NumeroStand</span>
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <span class="badge bg-secondary mb-2">@Model.Categoria</span>
                    <h5 class="fw-bold">Descripción</h5>
                    <p class="text-muted">@Model.Descripcion</p>
                </div>

                <hr>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <p class="mb-1"><strong>Precio base / Inversión:</strong></p>
                        <p class="text-success fw-bold fs-5 mb-0">@Model.PrecioBase.ToString("C0")</p>
                    </div>
                    <div class="col-12 col-md-6">
                        <p class="mb-1"><strong>Fecha de registro:</strong></p>
                        <p class="text-muted mb-0">@Model.FechaRegistro.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div class="col-12 col-md-6">
                        <p class="mb-1"><strong>Fundador / Representante:</strong></p>
                        <p class="text-dark mb-0">@Model.NombreEmprendedor</p>
                    </div>
                    <div class="col-12 col-md-6">
                        <p class="mb-1"><strong>Contacto:</strong></p>
                        <p class="text-muted mb-0">
                            @Model.CorreoContacto | Tel: @Model.Telefono
                        </p>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-secondary btn-sm">Volver</a>
                    <div class="d-flex gap-2">
                        <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                            Modificar
                        </a>
                        <form method="post" asp-action="Eliminar" onsubmit="return confirm('¿Seguro que deseas eliminar este stand?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                Eliminar
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
