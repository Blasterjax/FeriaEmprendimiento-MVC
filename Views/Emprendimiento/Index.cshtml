@model FeriaEmprendimiento.Models.CatalogoViewModel
@{
    ViewData["Title"] = "Catálogo de Stands";
}

<!-- Encabezado y resumen -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3 border-bottom pb-2">
    <div>
        <h2 class="h4 fw-bold mb-0">Catálogo de Stands en Exhibición</h2>
        <span class="text-muted small">Total de stands registrados: <strong>@Model.TotalStands</strong></span>
    </div>
    <div>
        <a asp-action="Crear" class="btn btn-success btn-sm">
            + Registrar Nuevo Stand
        </a>
    </div>
</div>

<!-- Filtros y Búsqueda -->
<div class="card shadow-sm border p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-12 col-md-6">
            <input type="text" name="busqueda" value="@Model.TerminoBusqueda" 
                   class="form-control form-control-sm" 
                   placeholder="Buscar por nombre, stand o fundador...">
        </div>

        <div class="col-8 col-md-4">
            <select name="categoria" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="Todos" selected="@(Model.CategoriaSeleccionada == "Todos" || string.IsNullOrEmpty(Model.CategoriaSeleccionada))">
                    Todas las categorías
                </option>
                @foreach (var cat in Model.CategoriasDisponibles)
                {
                    <option value="@cat" selected="@(Model.CategoriaSeleccionada == cat)">
                        @cat
                    </option>
                }
            </select>
        </div>

        <div class="col-4 col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-primary btn-sm w-100">
                Buscar
            </button>
            @if (!string.IsNullOrEmpty(Model.TerminoBusqueda) || (!string.IsNullOrEmpty(Model.CategoriaSeleccionada) && Model.CategoriaSeleccionada != "Todos"))
            {
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Limpiar filtro">
                    Limpiar
                </a>
            }
        </div>
    </form>

    <!-- Botones de categoría -->
    <div class="mt-3 pt-2 border-top d-flex flex-wrap gap-1 align-items-center">
        <span class="small text-muted me-1">Filtrar por:</span>
        <a asp-action="Index" asp-route-categoria="Todos" 
           class="btn btn-sm @(Model.CategoriaSeleccionada == "Todos" || string.IsNullOrEmpty(Model.CategoriaSeleccionada) ? "btn-primary" : "btn-outline-primary")">
            Todos
        </a>
        @foreach (var cat in Model.CategoriasDisponibles)
        {
            var isSelected = Model.CategoriaSeleccionada == cat;
            <a asp-action="Index" asp-route-categoria="@cat" 
               class="btn btn-sm @(isSelected ? "btn-primary" : "btn-outline-primary")">
                @cat
            </a>
        }
    </div>
</div>

<!-- Listado de Stands -->
@if (!Model.Emprendimientos.Any())
{
    <div class="alert alert-info text-center my-4" role="alert">
        No se encontraron emprendimientos registrados con los criterios seleccionados.
        <div class="mt-2">
            <a asp-action="Index" class="btn btn-outline-primary btn-sm">Ver todos</a>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var stand in Model.Emprendimientos)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary">@stand.Categoria</span>
                            <span class="badge bg-secondary">Stand @stand.NumeroStand</span>
                        </div>

                        <h5 class="card-title fw-bold mb-1">@stand.Nombre</h5>
                        <p class="card-text text-muted small flex-grow-1 mb-2">@stand.Descripcion</p>

                        <div class="small text-secondary mb-2">
                            <div><strong>Fundador:</strong> @stand.NombreEmprendedor</div>
                            <div><strong>Contacto:</strong> @stand.CorreoContacto</div>
                        </div>

                        <div class="mb-3">
                            <strong class="text-success">Precio base: @stand.PrecioBase.ToString("C0")</strong>
                        </div>

                        <div class="d-flex gap-1 pt-2 border-top mt-auto">
                            <a asp-action="Detalles" asp-route-id="@stand.Id" class="btn btn-outline-primary btn-sm flex-fill">
                                Detalles
                            </a>
                            <a asp-action="Editar" asp-route-id="@stand.Id" class="btn btn-outline-secondary btn-sm">
                                Editar
                            </a>
                            <button type="button" class="btn btn-outline-danger btn-sm" 
                                    data-bs-toggle="modal" 
                                    data-bs-target="#modalEliminar" 
                                    data-id="@stand.Id" 
                                    data-nombre="@stand.Nombre" 
                                    data-stand="@stand.NumeroStand">
                                Eliminar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Modal de confirmación para eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title h6 mb-0" id="modalEliminarLabel">Confirmar Eliminación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="mb-1">¿Deseas retirar el siguiente stand de la feria?</p>
                <h6 class="fw-bold text-danger my-2" id="modalNombreStand">--</h6>
            </div>
            <div class="modal-footer justify-content-center border-0 pt-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <form method="post" asp-action="Eliminar" id="formEliminar">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="modalIdStand" value="" />
                    <button type="submit" class="btn btn-danger btn-sm">Sí, Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalEliminar = document.getElementById('modalEliminar');
        if (modalEliminar) {
            modalEliminar.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-id');
                const nombre = button.getAttribute('data-nombre');
                const stand = button.getAttribute('data-stand');

                document.getElementById('modalIdStand').value = id;
                document.getElementById('modalNombreStand').textContent = nombre + " (Stand: " + stand + ")";
            });
        }
    </script>
}
