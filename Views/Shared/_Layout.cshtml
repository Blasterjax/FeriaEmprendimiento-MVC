<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Feria de Emprendimiento</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

    <!-- Barra de navegación -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    Feria de Emprendimiento
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContenido" 
                        aria-controls="navbarContenido" aria-expanded="false" aria-label="Navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContenido">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Emprendimiento" asp-action="Index">Catálogo de Stands</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Emprendimiento" asp-action="Crear">Registrar Stand</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Alertas de TempData -->
    <div class="container mt-3">
        @if (TempData["Mensaje"] != null)
        {
            var tipo = TempData["TipoMensaje"]?.ToString() ?? "info";
            <div class="alert alert-@tipo alert-dismissible fade show" role="alert">
                @TempData["Mensaje"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
    </div>

    <!-- Contenido principal -->
    <main role="main" class="flex-grow-1 pb-4">
        <div class="container mt-2">
            @RenderBody()
        </div>
    </main>

    <!-- Pie de página -->
    <footer class="bg-dark text-white py-3 border-top mt-auto">
        <div class="container text-center">
            <p class="mb-1 small">
                Feria de Emprendimiento &copy; 2026
            </p>
            <p class="text-secondary small mb-0">
                Desarrollado por <strong>Samuel Cortés Guirales</strong> | Programación Web
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
