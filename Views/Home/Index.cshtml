@model FeriaEmprendimiento.Models.CatalogoViewModel
@{
    ViewData["Title"] = "Inicio";
}

<!-- Banner principal -->
<div class="p-4 p-md-5 mb-4 bg-white rounded-3 shadow-sm border text-center">
    <h1 class="h2 fw-bold text-dark mb-2">Feria Universitaria de Emprendimiento 2026</h1>
    <p class="text-muted col-md-8 mx-auto mb-4">
        Plataforma web para la consulta y registro de proyectos y stands participantes en la feria universitaria.
    </p>
    <div class="d-flex justify-content-center gap-2">
        <a asp-controller="Emprendimiento" asp-action="Index" class="btn btn-primary">
            Ver Catálogo de Stands
        </a>
        <a asp-controller="Emprendimiento" asp-action="Crear" class="btn btn-success">
            Registrar Nuevo Stand
        </a>
    </div>
</div>

<!-- Resumen de estadísticas -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card shadow-sm border text-center p-3 h-100">
            <h6 class="text-muted small text-uppercase mb-1">Total de Stands</h6>
            <h3 class="fw-bold text-primary mb-0">@Model.TotalStands</h3>
            <span class="text-muted small">Registrados en la feria</span>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card shadow-sm border text-center p-3 h-100">
            <h6 class="text-muted small text-uppercase mb-1">Categorías</h6>
            <h3 class="fw-bold text-success mb-0">@Model.TotalCategorias</h3>
            <span class="text-muted small">Áreas participantes</span>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card shadow-sm border text-center p-3 h-100">
            <h6 class="text-muted small text-uppercase mb-1">Inversión Promedio</h6>
            <h3 class="fw-bold text-dark mb-0">@Model.PromedioPrecios.ToString("C0")</h3>
            <span class="text-muted small">Base por stand</span>
        </div>
    </div>
</div>

<!-- Stands en exhibición destacados -->
<div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
    <h4 class="fw-bold mb-0">Stands Destacados</h4>
    <a asp-controller="Emprendimiento" asp-action="Index" class="btn btn-outline-primary btn-sm">
        Ver todos los stands
    </a>
</div>

<div class="row g-3 mb-4">
    @foreach (var stand in Model.Emprendimientos.Take(4))
    {
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-primary">@stand.Categoria</span>
                        <span class="badge bg-secondary">Stand @stand.NumeroStand</span>
                    </div>

                    <h5 class="card-title fw-bold">@stand.Nombre</h5>
                    <p class="card-text text-muted small flex-grow-1">@stand.Descripcion</p>

                    <p class="mb-1 small"><strong>Fundador:</strong> @stand.NombreEmprendedor</p>
                    <p class="mb-3 text-success fw-bold">Precio base: @stand.PrecioBase.ToString("C0")</p>

                    <a asp-controller="Emprendimiento" asp-action="Detalles" asp-route-id="@stand.Id" 
                       class="btn btn-outline-primary btn-sm mt-auto">
                        Ver Detalles
                    </a>
                </div>
            </div>
        </div>
    }
</div>
